# Default: mock flights/hotels/cabs; persistent local demo bookings, no payments.
DEMO_MODE=true
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
APP_NAME=VoyageZero
DEFAULT_CURRENCY=INR
TRAVEL_TIMEZONE=Asia/Kolkata
TRAVEL_SESSION_HOURS=24
TRAVEL_DATA_FILE=data/travel.json

# Optional in demo: blank uses the deterministic English intent fallback.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Meta credentials are required to receive/send actual WhatsApp messages.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Connected searches (DEMO_MODE=false): Duffel TEST token; Stays access for hotels.
DUFFEL_ACCESS_TOKEN=
ORS_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VOUCHERS_BUCKET=vouchers

# Existing Stripe/API package flow only; conversational bookings never use Stripe.
# Leave these out entirely unless enabling the existing Stripe integration.
# STRIPE_SECRET_KEY=your_stripe_test_key
# STRIPE_WEBHOOK_SECRET=your_stripe_test_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000
STRIPE_CANCEL_URL=http://localhost:3000
CAB_BASE_FARE_MINOR=300
CAB_PER_KM_MINOR=125
CAB_PER_MINUTE_MINOR=25
